datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SOLICITANTE
  COORDINADOR
  BODEGA
  AUDITOR
}

enum Priority {
  NORMAL
  ALTA
}

enum RequestStatus {
  BORRADOR
  ENVIADA
  RESERVADA
  DESPACHADA
  ENTREGADA
  CANCELADA
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  skus      SKU[]
  inventory Inventory[]
  users     User[]       // Si tu modelo de usuarios también está relacionado
  requests  Request[]    // Si aplica a tus solicitudes
  auditEvents  AuditEvent[]
  aiSummaries  AISummary[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           Role
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     Request[]    @relation("RequestOwner")
  auditEvents  AuditEvent[]
  aiSummaries  AISummary[]  @relation("SummaryCreator")

  @@index([organizationId])
  @@map("users")
}

model SKU {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       
  name           String
  description    String?
  organizationId String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  requestItems   RequestItem[]

  @@unique([organizationId, code]) 
}

model Inventory {
  id              String       @id @default(uuid()) @db.Uuid
  skuId           String       @db.Uuid
  quantity        Int
  organizationId  String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sku             SKU          @relation(fields: [skuId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, skuId]) 
}

model Request {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  requesterId    String        @map("requester_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  zone           String
  priority       Priority      @default(NORMAL)
  requiredDate   DateTime      @map("required_date")
  observations   String?
  status         RequestStatus @default(BORRADOR)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  requester    User                @relation("RequestOwner", fields: [requesterId], references: [id])
  organization Organization        @relation(fields: [organizationId], references: [id])
  items        RequestItem[]
  audits       AuditEvent[]
  idempotency  IdempotencyRecord[]
  summaries    AISummary[]

  @@index([organizationId, status, priority])
  @@index([requesterId, createdAt])
  @@map("requests")
}

model RequestItem {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid
  skuId     String @map("sku_id") @db.Uuid
  quantity  Int

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sku     SKU     @relation(fields: [skuId], references: [id])

  @@map("request_items")
}

model IdempotencyRecord {
  id             String       @id @default(uuid()) @db.Uuid
  key            String
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  requestHash    String       @map("request_hash")
  responseCode   Int          @map("response_code")
  responseBody   Json         @map("response_body")
  createdAt      DateTime     @default(now()) @map("created_at")

  request        Request?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId      String?      @map("request_id") @db.Uuid

  @@unique([key, organizationId])
  @@map("idempotency_records")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  action         String
  correlationId  String   @map("correlation_id")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  request      Request?     @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model AISummary {
  id             String    @id @default(uuid()) @db.Uuid
  requestId      String?   @map("request_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  creatorId      String    @map("creator_id") @db.Uuid
  summary        String
  recommendations Json
  approvedAt     DateTime? @map("approved_at")
  approvedById   String?   @map("approved_by_id") @db.Uuid
  source         String
  createdAt      DateTime  @default(now()) @map("created_at")

  request      Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("SummaryCreator", fields: [creatorId], references: [id])

  @@index([organizationId, createdAt])
  @@map("ai_summaries")
}